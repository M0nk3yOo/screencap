<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Compact icon buttons used in the preview window. -->
  <Style Selector="Button.tool, ToggleButton.tool">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Flat toolbar buttons: transparent until hovered, accent when checked. -->
  <Style Selector="Button.flat, ToggleButton.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.flat PathIcon, ToggleButton.flat PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <!-- Rounded "pill" that groups related tools. -->
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource ScGroupBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,6" />
    <Setter Property="Background" Value="{DynamicResource ScDividerBrush}" />
  </Style>

  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#30000000" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="2,0" />
  </Style>
  <Style Selector="Border.swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <!-- Tab chips in the main window title bar. -->
  <Style Selector="Border.tab">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,4,4,4" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource ScTabHoverBrush}" />
  </Style>
  <Style Selector="Border.tab.selected">
    <Setter Property="Background" Value="{DynamicResource ScTabSelectedBrush}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #26000000" />
  </Style>
  <Style Selector="Border.tab Button.tabClose">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.tab:pointerover Button.tabClose, Border.tab.selected Button.tabClose">
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Button.tabClose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <!-- Floating tool options under the toolbar. -->
  <Style Selector="Border.popup">
    <Setter Property="Background" Value="{DynamicResource ScChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ScDividerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #30000000" />
  </Style>
  <Style Selector="ToggleButton.textStyle TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Width" Value="16" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- Layer rows. -->
  <Style Selector="Border.layer">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="8,4,2,4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.layer:pointerover">
    <Setter Property="Background" Value="{DynamicResource ScTabHoverBrush}" />
  </Style>
  <Style Selector="Border.layer.selected">
    <Setter Property="Background" Value="{DynamicResource ScTabSelectedBrush}" />
  </Style>
  <Style Selector="Border.layer.hidden TextBlock">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Removable custom color swatches. -->
  <Style Selector="Button.swatchRemove">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,-5,-3,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="#E0303034" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.customSwatch:pointerover Button.swatchRemove">
    <Setter Property="IsVisible" Value="True" />
  </Style>
</Styles>
