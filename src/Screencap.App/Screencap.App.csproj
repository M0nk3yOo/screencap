<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net10.0 for macOS, the Windows TFM adds the Windows platform layer (WinRT OCR). -->
    <TargetFramework />
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Screencap</AssemblyName>
    <RootNamespace>Screencap.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$(TargetFramework.Contains('-windows'))">..\..\assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\AppIcon.ico" Link="Assets\AppIcon.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Screencap.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Screencap.Core\Screencap.Core.csproj" />
    <ProjectReference Include="..\Screencap.Platform.MacOS\Screencap.Platform.MacOS.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="..\Screencap.Platform.Windows\Screencap.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
